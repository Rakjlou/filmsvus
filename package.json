{
  "name": "filmsvus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "import:xlsx": "node --env-file-if-exists=.env scripts/import-xlsx.ts",
    "hydrate": "node --env-file-if-exists=.env scripts/hydrate.ts",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "jszip": "^3.10.2",
    "typescript": "^6.0.0"
  }
}
